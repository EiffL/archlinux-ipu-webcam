#!/usr/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail

die() { printf 'ipu-webcam: %s\n' "$*" >&2; exit 1; }

load_config() {
  DEVICE=/dev/video60
  CARD_LABEL='Dell XPS 9315 Camera'
  WIDTH=1280 HEIGHT=720 FRAMERATE=30 WAIT_SECONDS=45 USE_TUNING=yes FRAMING=crop
  local config=${IPU_WEBCAM_CONFIG:-/etc/archlinux-ipu-webcam.conf}
  if [[ -f $config ]]; then source "$config"; fi
  [[ $DEVICE =~ ^/dev/video[0-9]+$ ]] || die 'DEVICE must be /dev/video followed by a number'
  [[ -n $CARD_LABEL && ${#CARD_LABEL} -le 31 && $CARD_LABEL != *$'\n'* ]] || die 'CARD_LABEL must contain 1–31 characters'
  local key value
  for key in WIDTH HEIGHT FRAMERATE WAIT_SECONDS; do
    value=${!key}
    [[ $value =~ ^[1-9][0-9]*$ && ${#value} -le 4 ]] || die "Invalid $key: $value"
  done
  (( WIDTH >= 16 && WIDTH <= 4096 && HEIGHT >= 16 && HEIGHT <= 4096 )) || die 'Dimensions must be 16–4096'
  (( WIDTH % 2 == 0 )) || die 'YUY2 requires an even WIDTH'
  (( FRAMERATE <= 60 && WAIT_SECONDS <= 50 )) || die 'FRAMERATE must be <=60 and WAIT_SECONDS <=50'
  [[ $USE_TUNING == yes || $USE_TUNING == no ]] || die 'USE_TUNING must be yes or no'
  [[ $FRAMING == crop || $FRAMING == fit ]] || die 'FRAMING must be crop or fit'
  export LC_ALL=C LIBCAMERA_PIPELINES_MATCH_LIST=simple
  if [[ $USE_TUNING == yes ]]; then
    export LIBCAMERA_IPA_CONFIG_PATH=${IPU_WEBCAM_DATA_DIR:-/usr/share/archlinux-ipu-webcam}/ipa
  else
    unset LIBCAMERA_IPA_CONFIG_PATH
  fi
}

check_hardware() {
  [[ $(cat /sys/class/dmi/id/product_name) == 'XPS 9315' ]] || die 'This profile supports the Dell XPS 9315 only'
  [[ $(cat /sys/bus/pci/devices/0000:00:05.0/vendor) == 0x8086 &&
     $(cat /sys/bus/pci/devices/0000:00:05.0/device) == 0x465d ]] || die 'Expected Alder Lake IPU6 controller not found'
}

check_loopback() {
  local node=${DEVICE##*/} sys_path
  [[ -c $DEVICE ]] || die "$DEVICE does not exist; check the prepare service and reboot after installation"
  sys_path=$(readlink -f "/sys/class/video4linux/$node")
  [[ $sys_path == "/sys/devices/virtual/video4linux/$node" ]] || die "$DEVICE is not a loopback; refusing to use it"
  [[ $(cat "$sys_path/name") == "$CARD_LABEL" ]] || die "$DEVICE belongs to another virtual camera; choose a free DEVICE and reboot"
}

ensure_udmabuf() {
  # CONFIG_UDMABUF=y provides the device without a loadable module or a
  # modules.builtin entry. Only try modprobe when the device is absent.
  local device=${1:-/dev/udmabuf}
  [[ -c $device ]] || modprobe udmabuf
}

prepare_device() {
  (( EUID == 0 )) || die 'prepare must run as root (normally via systemd)'
  check_hardware
  # Do not unload modules or remove other applications' virtual cameras.
  ensure_udmabuf
  modprobe v4l2loopback devices=0
  if [[ ! -e $DEVICE ]]; then
    v4l2loopback-ctl add -n "$CARD_LABEL" -x 1 "$DEVICE"
  fi
  udevadm settle --timeout=10
  check_loopback
}

wait_camera() {
  check_hardware
  check_loopback
  local deadline=$((SECONDS + WAIT_SECONDS)) media graph listing='No sensor available yet'
  while (( SECONDS < deadline )); do
    if { [[ -r /dev/udmabuf && -w /dev/udmabuf ]] ||
         [[ -r /dev/dma_heap/system && -w /dev/dma_heap/system ]]; }; then
      for media in /dev/media[0-9]*; do
        [[ -c $media ]] || continue
        graph=$(media-ctl -p -d "$media" 2>/dev/null) || continue
        # A media node exists before the asynchronous sensor probe finishes.
        # Wait for the sensor entity, then verify libcamera as the service user.
        if [[ $graph == *'ov01a10 '* ]]; then
          if listing=$(timeout 5s cam -l 2>&1) && [[ $listing =~ $'\n'1:\  ]]; then
            printf 'ipu-webcam: libcamera and DMA buffer access are ready\n'
            return 0
          fi
        fi
      done
    else
      listing='No accessible DMA buffer provider (check video/render/kvm group access)'
    fi
    sleep 1
  done
  printf '%s\n' "$listing" >&2
  die 'Camera readiness timed out; systemd will retry'
}

framing_pipeline() {
  if [[ $FRAMING == crop ]]; then
    printf 'aspectratiocrop aspect-ratio=%s/%s ! videoscale add-borders=false' "$WIDTH" "$HEIGHT"
  else
    printf 'videoscale add-borders=true'
  fi
}

run_relay() {
  check_loopback
  local caps="video/x-raw,format=YUY2,width=$WIDTH,height=$HEIGHT,framerate=$FRAMERATE/1"
  caps+=',pixel-aspect-ratio=1/1,interlace-mode=progressive,colorimetry=bt709'
  exec "${IPU_WEBCAM_RELAY:-/usr/lib/archlinux-ipu-webcam/v4l2-relayd}" \
    -i "libcamerasrc ! queue max-size-buffers=2 leaky=downstream ! videoconvert ! $(framing_pipeline) ! videorate" \
    -s 'videotestsrc pattern=black num-buffers=2 ! videoconvert' \
    -o "appsrc name=appsrc caps=$caps ! queue max-size-buffers=2 leaky=downstream ! v4l2sink name=v4l2sink device=$DEVICE io-mode=mmap sync=false"
}

main() {
  load_config
  case ${1:-status} in
    prepare) prepare_device ;;
    wait) wait_camera ;;
    relay) run_relay ;;
    test)
      check_loopback
      printf 'Capturing 60 virtual-camera frames; no images will be saved.\n'
      timeout 20s gst-launch-1.0 -e v4l2src device="$DEVICE" num-buffers=60 ! fakesink sync=false
      ;;
    status)
      systemctl --no-pager --full status archlinux-ipu-webcam.service archlinux-ipu-webcam-prepare.service
      ;;
    *) printf 'Usage: ipu-webcam [status|test|prepare|wait|relay]\n' >&2; return 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
